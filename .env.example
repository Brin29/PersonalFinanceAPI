# ============================================
# Personal Finance Tracker API - Variables de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA subas tu .env real a GitHub.
# ============================================

# Entorno de ejecución: development | production
NODE_ENV=development

# URL pública de la API (se muestra en logs y Swagger)
APP_URL=http://localhost:4000

# Puerto en el que escucha el servidor
PORT=4000

# Conexión a MongoDB (local o MongoDB Atlas)
# Ejemplo Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/<db>
MONGO_URI=mongodb://localhost:27017/personal_finance_track

# Secretos para firmar tokens JWT y cookies
# Generar con: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here

# SMTP para envío de correos (Gmail recomendado)
# Para Gmail usa una App Password (no la contraseña de la cuenta)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=Finance <your_email@gmail.com>

# URL del frontend (permisos CORS)
FRONTEND_URL=http://localhost:3000

# URL base de la API usada en callbacks OAuth
CLIENT_URL=http://localhost:4000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
REDIRECT_URL=http://localhost:4000/auth/google/callback

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Cloudinary para subida de avatares (https://cloudinary.com)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
IMG_SRC=https://res.cloudinary.com
